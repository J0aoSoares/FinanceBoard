
# --- Banco (interno ao Docker; nenhuma porta é exposta no notebook) ---
POSTGRES_USER=financeboard
POSTGRES_PASSWORD=password
POSTGRES_DB=financeboard

# --- Endereço do site na rede. Os dois PCs precisam resolver esse nome
#     para o IP do notebook (arquivo hosts) — ver deploy/README.md ---
SITE_ADDRESS=financeboard.local

# --- API ---
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# --- Primeiro ADMIN (criado/atualizado a cada subida; senha: 10+ chars com letra e número) ---
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Em produção deixe false: true cria empresas, obras e contas FICTÍCIAS num banco vazio.
SEED_SAMPLE_DATA=false

# --- Backup diário (pasta ./backups no notebook) ---
BACKUP_KEEP_DAYS=30

POSTGRES_USER=financeboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=financeboard
POSTGRES_PORT=5432

DATABASE_URL="postgresql://financeboard:change-me@localhost:5432/financeboard?schema=public"

PORT=3000

# Autenticação
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_PURGE_INTERVAL_HOURS=12

# Origens permitidas no CORS, separadas por vírgula (5173 é a porta do Vite)
CORS_ORIGINS=http://localhost:5173

# Rate limit do POST /auth/login
LOGIN_RATE_LIMIT_TTL_SECONDS=300
LOGIN_RATE_LIMIT_MAX=10

# Usuário ADMIN criado pelo seed. Sem valores o seed falha de propósito.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum TaxType {
  INSS
  ISS
  IRRF
  PIS_COFINS_CSLL
}

model Company {
  id        String   @id @default(cuid())
  legalName String
  cnpj      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills             Bill[]
  invoices          Invoice[]
  receivables       Receivable[]
  projectBillings   ProjectBilling[]
  retainageReleases RetainageRelease[]

  @@map("companies")
}

model Project {
  id         String        @id @default(cuid())
  name       String
  nameKey    String        @unique
  clientName String
  status     ProjectStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  bills             Bill[]
  receivables       Receivable[]
  projectBillings   ProjectBilling[]
  retainageReleases RetainageRelease[]

  @@map("projects")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  nameKey   String   @unique
  createdAt DateTime @default(now())

  bills Bill[]

  @@map("categories")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique
  document  String?
  createdAt DateTime @default(now())

  bills    Bill[]
  invoices Invoice[]

  @@map("suppliers")
}

model Invoice {
  id          String        @id @default(cuid())
  number      String
  companyId   String
  supplierId  String?
  dueDate     DateTime
  paymentDate DateTime?
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  bills    Bill[]

  @@index([companyId, dueDate])
  @@index([supplierId])
  @@map("invoices")
}

model BillGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  bills Bill[]

  @@map("bill_groups")
}

model Bill {
  id                String        @id @default(cuid())
  documentNumber    String?
  description       String
  digitableLine     String?
  installmentLabel  String?
  installmentNumber Int?
  grossAmount       Decimal       @db.Decimal(12, 2)
  netAmount         Decimal       @db.Decimal(12, 2)
  issueDate         DateTime?
  dueDate           DateTime
  paymentDate       DateTime?
  status            PaymentStatus @default(PENDING)
  hasTaxWithholding Boolean       @default(false)

  companyId  String
  projectId  String?
  categoryId String
  supplierId String
  invoiceId  String?
  groupId    String?

  company  Company    @relation(fields: [companyId], references: [id])
  project  Project?   @relation(fields: [projectId], references: [id])
  category Category   @relation(fields: [categoryId], references: [id])
  supplier Supplier   @relation(fields: [supplierId], references: [id])
  invoice  Invoice?   @relation(fields: [invoiceId], references: [id])
  group    BillGroup? @relation(fields: [groupId], references: [id])

  taxWithholdings TaxWithholding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, installmentLabel])
  @@index([companyId, issueDate])
  @@index([companyId, paymentDate])
  @@index([dueDate])
  @@index([projectId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([invoiceId])
  @@map("bills")
}

model TaxWithholding {
  id     String  @id @default(cuid())
  billId String
  type   TaxType
  amount Decimal @db.Decimal(12, 2)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([billId, type])
  @@map("tax_withholdings")
}

model Receivable {
  id          String        @id @default(cuid())
  number      String?
  description String
  clientName  String
  grossAmount Decimal       @db.Decimal(12, 2)
  netAmount   Decimal       @db.Decimal(12, 2)
  competence  DateTime
  issueDate   DateTime
  dueDate     DateTime
  receiptDate DateTime?
  status      PaymentStatus @default(PENDING)

  companyId String
  projectId String?

  company Company  @relation(fields: [companyId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  withholdings ReceivableWithholding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, issueDate])
  @@index([companyId, receiptDate])
  @@index([companyId, competence])
  @@index([projectId])
  @@map("receivables")
}

model ReceivableWithholding {
  id           String  @id @default(cuid())
  receivableId String
  type         TaxType
  amount       Decimal @db.Decimal(12, 2)

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([receivableId, type])
  @@map("receivable_withholdings")
}

model Bank {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  projectBillings   ProjectBilling[]
  retainageReleases RetainageRelease[]

  @@map("banks")
}

model ProjectBilling {
  id               String    @id @default(cuid())
  number           String
  amount           Decimal   @db.Decimal(12, 2)
  retainageAmount  Decimal   @default(0) @db.Decimal(12, 2)
  retainagePercent Decimal?  @db.Decimal(5, 2)
  netAmount        Decimal   @db.Decimal(12, 2)
  dueDate          DateTime
  paymentDate      DateTime?

  companyId String
  projectId String
  bankId    String?

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  bank    Bank?   @relation(fields: [bankId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, dueDate])
  @@index([companyId, paymentDate])
  @@index([projectId])
  @@index([bankId])
  @@map("project_billings")
}

model RetainageRelease {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  returnDate DateTime

  projectId String
  companyId String
  bankId    String

  project Project @relation(fields: [projectId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  bank    Bank    @relation(fields: [bankId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId, companyId])
  @@index([companyId, returnDate])
  @@index([bankId])
  @@map("retainage_releases")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
